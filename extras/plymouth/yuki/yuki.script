# Boot splash matching yuki: accent NixOS snowflake inside a rotating
# arc, a lock-screen style password pill for disk unlock, fade out on quit.

Window.SetBackgroundTopColor(0.071, 0.075, 0.094);    # base #121318
Window.SetBackgroundBottomColor(0.051, 0.055, 0.075); # crust #0d0e13

cx = Window.GetX() + Window.GetWidth() / 2;
cy = Window.GetY() + Window.GetHeight() / 2;

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(cx - logo.image.GetWidth() / 2, cy - logo.image.GetHeight() / 2, 10);
logo.sprite.SetOpacity(0);

track.image = Image("track.png");
track.sprite = Sprite(track.image);
track.sprite.SetPosition(cx - track.image.GetWidth() / 2, cy - track.image.GetHeight() / 2, 5);
track.sprite.SetOpacity(0);

arc.image = Image("arc.png");
arc.sprite = Sprite();
arc.sprite.SetZ(6);

entry.image = Image("entry.png");
entry.sprite = Sprite(entry.image);
entry.sprite.SetPosition(cx - entry.image.GetWidth() / 2, cy + 150, 20);
entry.sprite.SetOpacity(0);

bullet.image = Image("bullet.png");
prompt.sprite = Sprite();
prompt.sprite.SetZ(20);
message.sprite = Sprite();
message.sprite.SetZ(20);

bullets = [];
frame = 0;
fade = 0;
quitting = 0;
password_mode = 0;

fun refresh_callback() {
    frame++;

    # Fade in, or out when quitting.
    if (quitting) fade = Math.Max(0, fade - 0.06);
    else fade = Math.Min(1, fade + 0.04);

    logo.sprite.SetOpacity(fade);
    track.sprite.SetOpacity(fade * 0.8);

    # Arc rotates with a gentle ease (faster in the middle of each turn).
    t = frame / 90;
    angle = (t - Math.Sin(t * 2 * Math.Pi) / (2 * Math.Pi)) * 2 * Math.Pi;
    rotated = arc.image.Rotate(angle);
    arc.sprite.SetImage(rotated);
    arc.sprite.SetPosition(cx - rotated.GetWidth() / 2, cy - rotated.GetHeight() / 2, 6);
    arc.sprite.SetOpacity(fade * (1 - password_mode * 0.6));

    # Logo breathes slightly while booting.
    logo.sprite.SetOpacity(fade * (0.85 + 0.15 * Math.Sin(frame / 25)));
}
Plymouth.SetRefreshFunction(refresh_callback);

fun display_normal_callback() {
    password_mode = 0;
    entry.sprite.SetOpacity(0);
    prompt.sprite.SetOpacity(0);
    for (i = 0; bullets[i]; i++) bullets[i].SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

fun display_password_callback(text, count) {
    password_mode = 1;
    entry.sprite.SetOpacity(1);

    if (text == "") text = "Enter passphrase";
    prompt.image = Image.Text(text, 0.773, 0.776, 0.816, 1, "Inter 13");
    prompt.sprite.SetImage(prompt.image);
    prompt.sprite.SetPosition(cx - prompt.image.GetWidth() / 2, cy + 120, 20);
    prompt.sprite.SetOpacity(1);

    # Dots centered in the pill, like the lock screen.
    shown = Math.Min(count, 20);
    width = shown * 10 + (shown - 1) * 7;
    for (i = 0; i < 20; i++) {
        if (!bullets[i]) bullets[i] = Sprite(bullet.image);
        if (i < shown) {
            bullets[i].SetPosition(cx - width / 2 + i * 17, cy + 150 + 21, 21);
            bullets[i].SetOpacity(1);
        } else {
            bullets[i].SetOpacity(0);
        }
    }
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun message_callback(text) {
    message.image = Image.Text(text, 0.561, 0.565, 0.604, 1, "Inter 11");
    message.sprite.SetImage(message.image);
    message.sprite.SetPosition(cx - message.image.GetWidth() / 2, Window.GetY() + Window.GetHeight() - 64, 20);
}
Plymouth.SetMessageFunction(message_callback);

fun quit_callback() {
    quitting = 1;
}
Plymouth.SetQuitFunction(quit_callback);
